{
    "name": "Turbo Flow — the rig-lite kit",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/devcontainers/features/python:1": {}
    },
    "containerEnv": {
        "KIT_DIR": "${containerWorkspaceFolder}/rig-lite"
    },
    "postCreateCommand": "chmod +x ${containerWorkspaceFolder}/rig-lite/*.sh 2>/dev/null || true; bash ${containerWorkspaceFolder}/rig-lite/self-test.sh",
    "hostRequirements": {
        "memory": "4gb"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.cwd": "${containerWorkspaceFolder}",
                "terminal.integrated.shellIntegration.enabled": true,
                "workbench.startupEditor": "none"
            }
        }
    }
}
