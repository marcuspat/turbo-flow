#!/usr/bin/env bash
# git-deletion-guard — make staged deletions loud instead of silent.
# WARN-ONLY and fail-open: never blocks a commit; a two-second pause before
# `git add -A` eats a file is cheaper than a restore-from-refactor.
names=$(git diff --cached --name-only --diff-filter=D 2>/dev/null)
if [ -n "$names" ]; then
  echo "⚠️  RIG-LITE GUARD — staged DELETIONS:" >&2
  printf '    D %s\n' $names >&2
  echo "    intentional? commit again to proceed · accidental? git restore --staged <path>" >&2
fi
exit 0
