{
  "name": "turbo-flow",
  "version": "5.0.0-alpha.1",
  "description": "The agentic harness — write a spec, a bounded graph of agents runs it unattended, you get pinged only when a decision is genuinely yours.",
  "type": "module",
  "bin": {
    "turbo-flow": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/",
    "templates/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "agentic",
    "harness",
    "claude-code",
    "spec",
    "graph",
    "autonomous",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcuspat/turbo-flow.git",
    "directory": "packages/cli"
  }
}
